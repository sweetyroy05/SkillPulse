# SKILL PULSE — Environment Configuration
# Copy to .env and fill values. Never commit .env with real credentials.
# See backend/app/config.py for defaults & handling.

# Data source mode: LOCAL | ONLINE | AUTO_FALLBACK
# LOCAL = always use local JSON (default, safe for hackathon)
# ONLINE = always try Jooble live fetch
# AUTO_FALLBACK = try live, fall back to local if unavailable
DATA_SOURCE_MODE=LOCAL

# Jooble — primary live job market (https://jooble.org/api/about)
# Register at https://jooble.org/api/about to get an API key (POST https://jooble.org/api/{key})
# Each regional domain requires its own key; free plan = 500 requests lifetime
JOOBLE_API_KEY=
JOOBLE_BASE_URL=https://jooble.org/api
JOOBLE_RESULTS_PER_PAGE=10
JOOBLE_TIMEOUT_SECONDS=8

# Adzuna — deprecated (kept for backward compat, not used after Jooble migration)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in
# ADZUNA_BASE_URL=https://api.adzuna.com/v1/api

# O*NET — supplementary taxonomy (https://services.onetcenter.org)
# Optional; system works with Jooble+local even if blank
ONET_BASE_URL=https://services.onetcenter.org/v1.9
ONET_USERNAME=
ONET_PASSWORD=

# Cache
CACHE_TTL_SECONDS=3600
# CACHE_DIR=backend/.cache  (default)

