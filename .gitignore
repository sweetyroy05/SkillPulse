# SKILL PULSE — Root .gitignore
# Prevents secrets & generated files from being committed (critical for deployment)

# Secrets — NEVER commit real keys
.env
*.env
!.env.example
backend/.env
backend/*.env

# Cache & Python artifacts
__pycache__/
*.pyc
*.pyo
.cache/
backend/.cache/
backend/app/__pycache__/
backend/app/*/__pycache__/
backend/.venv/
backend/venv/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Frontend
frontend/node_modules/
.vercel/

# Logs
*.log
npm-debug.log*
